#!/usr/bin/env bash
# Run one command inside a lane: every disposable output is scoped to the lane,
# so concurrent lanes share only the source tree and the authored tests.
#
#   <pack>/tools/shared/lane [--config PATH] <lane> <command...>
set -euo pipefail

if [[ "${1:-}" == "--config" ]]; then
  [[ -n "${2:-}" ]] || { echo "usage: lane --config <path> <id> <command...>" >&2; exit 2; }
  export SWARM_CONFIG="$2"
  shift 2
fi

lane="${1:-}"
if [[ -z "$lane" || "$lane" == -* ]]; then
  echo "usage: lane <id> <command...>" >&2
  exit 2
fi
shift

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
pack_root="$(cd "$here/../.." && pwd)"
export SWARM_PACK="${SWARM_PACK:-$pack_root}"
export SWARM_LANE="$lane"
config="$(python3 "$here/harness.py" config)" || exit 2
artifacts="$(printf '%s' "$config" | python3 -c 'import json, sys; print(json.load(sys.stdin)["artifacts_root"])')"
state="$(printf '%s' "$config" | python3 -c 'import json, sys; print(json.load(sys.stdin)["state_root"])')"

# Per-lane claim metadata: awareness, not a lock. The last command to run in the
# lane records who ran it, so another session can tell a foreign change from a bug.
mkdir -p "$state"
owner_tmp="$state/owner.$$"
{
  printf 'session: %s\n' "${OPENCODE_SESSION_ID:-pid-$$}"
  printf 'pid: %s\n' "$$"
  printf 'host: %s\n' "${HOSTNAME:-$(uname -n 2>/dev/null || echo -)}"
  printf 'lane: %s\n' "$lane"
  printf 'updated: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$owner_tmp"
mv "$owner_tmp" "$state/owner"

mkdir -p "$artifacts/pycache" "$artifacts/tmp" "$artifacts/hypothesis" "$artifacts/pytest-cache" "$artifacts/testdata"
export SWARM_TEST_DATA="$artifacts/testdata"
export PYTHONPYCACHEPREFIX="$artifacts/pycache"
export TMPDIR="$artifacts/tmp"
export HYPOTHESIS_STORAGE_DIRECTORY="$artifacts/hypothesis"
export PYTEST_ADDOPTS="-o cache_dir=$artifacts/pytest-cache ${PYTEST_ADDOPTS:-}"

exec "$@"
